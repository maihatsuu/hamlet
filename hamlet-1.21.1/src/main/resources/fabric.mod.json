{
	"schemaVersion": 1,
	"id": "hamlet",
	"version": "${version}",
	"name": "Hamlet",
	"description": "Villagers do real work, keep what they produce, and sell it to you.",
	"authors": [
		"maihatsuu"
	],
	"contact": {
		"homepage": "https://github.com/maihatsuu/hamlet",
		"sources": "https://github.com/maihatsuu/hamlet"
	},
	"license": "CC0-1.0",
	"icon": "assets/hamlet/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"maihatsuu.hamlet.Hamlet"
		],
		"client": [
			"maihatsuu.hamlet.client.HamletClient"
		]
	},
	"mixins": [
		"hamlet.mixins.json",
		{
			"config": "hamlet.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}